{
  "name": "hwid-spoofer-gui",
  "version": "1.0.0",
  "description": "HWID Spoofer with Electron GUI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.hwidspoofer.gui",
    "productName": "HWID Spoofer",
    "directories": {
      "output": "dist_final"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "logo.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "to-ico": "^1.1.5"
  }
}
